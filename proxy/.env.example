# Provider keys — never put these in the SPA / Vite build
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Passcode gate (cmapalyzer CODE+MMDD or CODE+letter date)
ACCESS_CODES=EMCURE
ACCESS_VALIDITY_DAYS=7
# Optional master password
ACCESS_PASSWORD=

# Comma-separated browser origins. Include your GCS website host if it is not storage.googleapis.com.
CORS_ORIGINS=https://storage.googleapis.com,https://ai-app-directory.storage.googleapis.com,http://localhost:5173
